{
  "name": "@zeta-web/root",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build:packages": "for d in packages/*/; do [ -d \"$d/dist\" ] || rm -f \"$d\"*.tsbuildinfo; done; tsc -b && bun run --cwd packages/highlight build",
    "test": "bun test",
    "typecheck": "tsc -b",
    "check:zeta-events": "bun packages/zeta/scripts/check-events.ts",
    "bench:check": "bun scripts/bench-check.ts",
    "bench:markdown": "bun scripts/markdown-bench.ts",
    "bench:highlight": "bun run --cwd packages/highlight bench",
    "check:highlight-consumer": "bun scripts/highlight-consumer-check.ts",
    "check:highlight-notices": "bun scripts/highlight-notices-check.ts",
    "check:markdown-consumer": "bun scripts/markdown-consumer-check.ts",
    "check:pack-consumer": "bun scripts/pack-consumer-check.ts",
    "size:check": "bun scripts/size-check.ts",
    "vendor:markdown-it": "bun scripts/vendor-markdown-it.ts",
    "stress": "bun run --cwd apps/playground stress"
  },
  "devDependencies": {
    "@shikijs/engine-javascript": "4.6.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/types": "4.6.0",
    "markdown-it": "14.1.0",
    "shiki": "4.6.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "bun@1.3.13"
}
